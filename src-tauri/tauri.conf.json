{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PolyVoice Pro",
  "version": "0.9.0",
  "identifier": "com.polyvoice.pro",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "PolyVoice Pro — Phiên Dịch Hội Nghị Song Ngữ",
        "width": 1060,
        "height": 740,
        "minWidth": 820,
        "minHeight": 600,
        "center": true,
        "resizable": true
      },
      {
        "label": "overlay",
        "title": "PolyVoice Pro — Màn Hình Phụ Đề Hội Trường",
        "url": "index.html#overlay",
        "width": 1120,
        "height": 620,
        "minWidth": 560,
        "minHeight": 260,
        "center": true,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": true,
        "skipTaskbar": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "resources": {
      "resources/engine-bin/": "engine-bin/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhGOTBEREMwRkE2MTc2NjkKUldScGRtSDZ3TjJRandESGJlSGxVR0FNVlBXTFNoM0JPWXpHZ2p5dGR5NlpTYSs4YjFCYU4yNnEK",
      "endpoints": [
        "https://github.com/niitbeo/PolyVoice-Pro/releases/latest/download/latest.json"
      ]
    }
  }
}
